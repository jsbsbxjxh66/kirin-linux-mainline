# Link-time providers for the Balong modem.  This is the first build where
# modem objects actually reach vmlinux (earlier "successful" builds predate
# CONFIG_HISI_BALONG_MODEM), so the vendor feature switches that supply the
# symbols the modem references were never in kirin970_defconfig.  The set
# below mirrors merge_kirin970_defconfig from the Android reference kernel.
#   UDI_SUPPORT   -> mdrv_udi_open/ioctl/close/write (drv/udi/udi_balong.c)
#   IPF_SUPPORT   -> mdrv_ipf_* (drv/n_ipf/ipf_balong.c)
#   PSAM_SUPPORT  -> mdrv_psam_* (drv/n_psam/psam_balong.c)
#   SEC_CALL      -> drv/sec_call/sec_call.o
#   HW_IP_BASE_ADDR -> mdrv_phy_to_virt (drv/hwadp/hwadp_core.c)
#   IMAGE_LOAD    -> bsp_load_modem_images (drv/loadm/load_image.c)
#   EFUSE_BALONG_AGENT -> drv/efuse/efuse_balong_agent.o
#   HI3XXX_EFUSE  -> get_efuse_chipid_value/dieid (drivers/nvmem/)
#   DRMDRIVER     -> atfd_hisi_service_access_register_smc (drmdriver.c)
#   HIFI_MAILBOX  -> DRV_MAILBOX_SENDMAIL/REGISTERRECVFUNC/READMAILDATA
