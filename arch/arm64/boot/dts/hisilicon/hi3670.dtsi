#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/hi3670-clock.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "hisilicon,hi3670";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*
	 * PSCI 0.1 over the HVC conduit, exactly as the retail COR-AL00 DTB
	 * dumped off the device says (sys-fdt.decompiled.dts, /psci:
	 * method = "hvc" with these five function IDs).  The sys DTB is the
	 * authority here: it is what the vendor ATF actually answers to on
	 * this hardware, so the conduit and the IDs are not guesswork.
	 *
	 * Note the vendor kernel source (auto-generate/overlay/kirin970/
	 * kirin970_udp_cs_overlay.dtsi) says method = "smc", but that is the
	 * kirin970_udp_cs reference board, not COR-AL00.  Do not copy it.
	 */
	psci {
		compatible = "arm,psci";
		method = "hvc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		system_off = <0x84000008>;
		system_reset = <0x84000009>;
	};

	hhee {
		compatible = "hisilicon,hisi-hhee";
		interrupts = <GIC_SPI 350 IRQ_TYPE_LEVEL_HIGH>;
		status = "disabled";
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};
			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
				core2 {
					cpu = <&cpu6>;
				};
				core3 {
					cpu = <&cpu7>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP_0: cpu-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x0010000>;
				entry-latency-us = <40>;
				exit-latency-us = <70>;
				min-residency-us = <3000>;
			};

			CLUSTER_SLEEP_0: cluster-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <500>;
				exit-latency-us = <5000>;
				min-residency-us = <20000>;
			};

			CLUSTER_SLEEP_1: cluster-sleep-1 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <1000>;
				exit-latency-us = <5000>;
				min-residency-us = <20000>;
			};
		};

		cpu0: cpu@0 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER0>;
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_0>;
		};

		cpu1: cpu@1 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x1>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER0>;
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_0>;
		};

		cpu2: cpu@2 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x2>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER0>;
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_0>;
		};

		cpu3: cpu@3 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x3>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER0>;
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_0>;
		};

		cpu4: cpu@100 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x0 0x100>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER1>;
			operating-points-v2 = <&cluster1_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_1>;
		};

		cpu5: cpu@101 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x0 0x101>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER1>;
			operating-points-v2 = <&cluster1_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_1>;
		};

		cpu6: cpu@102 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x0 0x102>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER1>;
			operating-points-v2 = <&cluster1_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_1>;
		};

		cpu7: cpu@103 {
			compatible = "arm,cortex-a73";
			device_type = "cpu";
			reg = <0x0 0x103>;
			enable-method = "psci";
			clocks = <&stub_clock HI3670_CLK_STUB_CLUSTER1>;
			operating-points-v2 = <&cluster1_opp>;
			#cooling-cells = <2>;
			cpu-idle-states = <&CPU_SLEEP_0 &CLUSTER_SLEEP_1>;
		};
	};

	cluster0_opp: opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-509000000 {
			opp-hz = /bits/ 64 <509000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1018000000 {
			opp-hz = /bits/ 64 <1018000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1210000000 {
			opp-hz = /bits/ 64 <1210000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1402000000 {
			opp-hz = /bits/ 64 <1402000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1556000000 {
			opp-hz = /bits/ 64 <1556000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1844000000 {
			opp-hz = /bits/ 64 <1844000000>;
			clock-latency-ns = <2000000>;
		};
	};

	cluster1_opp: opp-table-1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-682000000 {
			opp-hz = /bits/ 64 <682000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1018000000 {
			opp-hz = /bits/ 64 <1018000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1210000000 {
			opp-hz = /bits/ 64 <1210000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1364000000 {
			opp-hz = /bits/ 64 <1364000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1498000000 {
			opp-hz = /bits/ 64 <1498000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1652000000 {
			opp-hz = /bits/ 64 <1652000000>;
			clock-latency-ns = <2000000>;
		};
		opp-1863000000 {
			opp-hz = /bits/ 64 <1863000000>;
			clock-latency-ns = <2000000>;
		};
		opp-2093000000 {
			opp-hz = /bits/ 64 <2093000000>;
			clock-latency-ns = <2000000>;
		};
		opp-2362000000 {
			opp-hz = /bits/ 64 <2362000000>;
			clock-latency-ns = <2000000>;
		};
	};

	gpu_opp: opp-table-2 {
		compatible = "operating-points-v2";
		opp-shared;

		/*
		 * The g3d rail is a fixed 950 mV rail whose enable/disable is
		 * delegated to LPM3; the regulator has no set_voltage op.  Keep
		 * every OPP at that voltage so the OPP core's regulator request
		 * is a no-op and only the clock is scaled, matching the vendor
		 * Mali kbase behaviour.
		 */
		opp-103750000 {
			opp-hz = /bits/ 64 <103750000>;
			opp-microvolt = <950000>;
		};
		opp-150909000 {
			opp-hz = /bits/ 64 <150909000>;
			opp-microvolt = <950000>;
		};
		opp-237143000 {
			opp-hz = /bits/ 64 <237143000>;
			opp-microvolt = <950000>;
		};
		opp-332000000 {
			opp-hz = /bits/ 64 <332000000>;
			opp-microvolt = <950000>;
		};
		opp-415000000 {
			opp-hz = /bits/ 64 <415000000>;
			opp-microvolt = <950000>;
		};
		opp-550000000 {
			opp-hz = /bits/ 64 <550000000>;
			opp-microvolt = <950000>;
		};
		opp-667000000 {
			opp-hz = /bits/ 64 <667000000>;
			opp-microvolt = <950000>;
		};
		opp-767000000 {
			opp-hz = /bits/ 64 <767000000>;
			opp-microvolt = <950000>;
		};
	};

	ddr_opp: opp-table-3 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-415000000 {
			opp-hz = /bits/ 64 <415000000>;
		};
		opp-830000000 {
			opp-hz = /bits/ 64 <830000000>;
		};
		opp-1244000000 {
			opp-hz = /bits/ 64 <1244000000>;
		};
		opp-1866000000 {
			opp-hz = /bits/ 64 <1866000000>;
		};
	};

	gic: interrupt-controller@e82b0000 {
		compatible = "arm,gic-400";
		/*
		 * Matches the retail DT exactly: only GICD and GICC are
		 * described, and GICC is one 4K page.  The old 2-page GICC plus
		 * GICH/GICV at 0x...4000/0x...6000 did not match the hardware
		 * (GIC-400 puts the virtual interface at 0x...6000/0x...8000),
		 * and a GICC larger than the real window makes
		 * gic_check_eoimode() probe past the CPU interface.
		 */
		reg = <0x0 0xe82b1000 0x0 0x1000>, /* GICD */
		      <0x0 0xe82b2000 0x0 0x1000>; /* GICC */
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* Carried over from the retail DT for parity; GIC-400 has no
		 * redistributor, so the kernel ignores it. */
		redistributor-stride = <0x0 0x30000>;
		interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(8) |
					 IRQ_TYPE_LEVEL_HIGH)>;
		interrupt-controller;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) |
					  IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) |
					  IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) |
					  IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) |
					  IRQ_TYPE_LEVEL_LOW)>;
		clock-frequency = <1920000>;
		arm,no-tick-in-suspend;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
				     <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
	};

	/*
	 * Shared LPAE SMMU page tables for the media subsystems.  The SMMU
	 * hardware itself is configured by firmware and the consumer drivers.
	 */
	smmu_lpae: iommu {
		compatible = "hisi,hisi-smmu-lpae";
		#iommu-cells = <0>;
	};

	cci: cci@e8100000 {
		compatible = "arm,cci-550";
		#address-cells = <2>;
		#size-cells = <2>;
		reg = <0x0 0xe8100000 0x0 0x1000>;
		ranges = <0x0 0x0 0x0 0xe8100000 0x0 0x100000>;

		pmu@10000 {
			compatible = "arm,cci-550-pmu,r0";
			reg = <0x0 0x10000 0x0 0x80000>;
			interrupts = <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 177 IRQ_TYPE_LEVEL_HIGH>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		crg_ctrl: crg_ctrl@fff35000 {
			compatible = "hisilicon,hi3670-crgctrl", "syscon";
			reg = <0x0 0xfff35000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		crg_rst: crg_rst_controller {
			compatible = "hisilicon,hi3670-reset",
				     "hisilicon,hi3660-reset";
			#reset-cells = <2>;
			hisi,rst-syscon = <&crg_ctrl>;
		};

		pctrl: pctrl@e8a09000 {
			compatible = "hisilicon,hi3670-pctrl", "syscon";
			reg = <0x0 0xe8a09000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		hwspinlock {
			compatible = "hisilicon,hwspinlock";
			hisilicon,syscon = <&pctrl>;
			hwlock,register-width = <32>;
			hwlock,bits-per-single = <4>;
			hwlock,groups = <8>;
			hwlock,offset = <0x400 0x40c 0x418 0x424
					 0x800 0x80c 0x818 0x824>;
		};

		mailbox: mailbox@e896b000 {
			compatible = "hisilicon,hi3670-mbox";
			reg = <0x0 0xe896b000 0x0 0x1000>;
			#mbox-cells = <1>;
			hisilicon,unlock-key = <0x1acce551>;

			mailbox-13 {
				hisilicon,index = <13>;
				hisilicon,src-bit = <0>;
				hisilicon,dst-bit = <3>;
				hisilicon,automatic-ack;
			};

			mailbox-14 {
				hisilicon,index = <14>;
				hisilicon,src-bit = <1>;
				hisilicon,dst-bit = <3>;
				hisilicon,sync;
			};

			mailbox-16 {
				hisilicon,index = <16>;
				hisilicon,src-bit = <0>;
				hisilicon,dst-bit = <3>;
				hisilicon,automatic-ack;
			};

			mailbox-0 {
				hisilicon,index = <0>;
				hisilicon,src-bit = <3>;
				hisilicon,dst-bit = <0>;
				interrupts = <GIC_SPI 197 IRQ_TYPE_LEVEL_HIGH>;
			};

			mailbox-5 {
				hisilicon,index = <5>;
				hisilicon,src-bit = <7>;
				hisilicon,dst-bit = <1>;
				interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_HIGH>;
			};

			mailbox-8 {
				hisilicon,index = <8>;
				hisilicon,src-bit = <8>;
				hisilicon,dst-bit = <1>;
				interrupts = <GIC_SPI 205 IRQ_TYPE_LEVEL_HIGH>;
			};

			mailbox-23 {
				hisilicon,index = <23>;
				hisilicon,src-bit = <0>;
				hisilicon,dst-bit = <8>;
				hisilicon,automatic-ack;
			};

			mailbox-25 {
				hisilicon,index = <25>;
				hisilicon,src-bit = <0>;
				hisilicon,dst-bit = <7>;
			};
		};

		hkadc: adc {
			compatible = "hisilicon,hi3670-hkadc";
			mboxes = <&mailbox 16>, <&mailbox 0>;
			mbox-names = "tx", "rx";
			#io-channel-cells = <1>;
			status = "okay";
		};

		pmuctrl: crg_ctrl@fff34000 {
			compatible = "hisilicon,hi3670-pmuctrl", "syscon";
			reg = <0x0 0xfff34000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		sctrl: sctrl@fff0a000 {
			compatible = "hisilicon,hi3670-sctrl", "syscon";
			reg = <0x0 0xfff0a000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		pmctrl: syscon@fff31000 {
			compatible = "hisilicon,hi3670-pmctrl", "syscon";
			reg = <0x0 0xfff31000 0x0 0x1000>;
		};

		stub_clock: stub-clock {
			compatible = "hisilicon,hi3670-stub-clk";
			#clock-cells = <1>;
			hisilicon,syscon = <&sctrl>;
			hisilicon,scbak-offset = <0x41c>;
			hisilicon,cluster0-opp = <&cluster0_opp>;
			hisilicon,cluster1-opp = <&cluster1_opp>;
			hisilicon,gpu-opp = <&gpu_opp>;
			hisilicon,ddr-opp = <&ddr_opp>;
			hisilicon,pmctrl = <&pmctrl>;
			mboxes = <&mailbox 13>;
		};

		iomcu: iomcu@ffd7e000 {
			compatible = "hisilicon,hi3670-iomcu", "syscon";
			reg = <0x0 0xffd7e000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		media1_crg: media1_crgctrl@e87ff000 {
			compatible = "hisilicon,hi3670-media1-crg", "syscon";
			reg = <0x0 0xe87ff000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		media2_crg: media2_crgctrl@e8900000 {
			compatible = "hisilicon,hi3670-media2-crg","syscon";
			reg = <0x0 0xe8900000 0x0 0x1000>;
			#clock-cells = <1>;
		};

		regulator_ip: regulator-ip {
			compatible = "hisilicon,hisi_regulator_ip_atf_core",
				     "simple-bus";
			#address-cells = <1>;
			#size-cells = <0>;

			media_subsys: regulator@0 {
				compatible = "ip-regulator-atf";
				reg = <0>;
				regulator-name = "media_subsys";
				hisilicon,hisi-regulator-id = <0>;
			};

			vivobus: regulator@1 {
				compatible = "ip-regulator-atf";
				reg = <1>;
				regulator-name = "vivobus";
				hisilicon,hisi-regulator-id = <1>;
				vin-supply = <&media_subsys>;
			};

			vcodecsubsys: regulator@2 {
				compatible = "ip-regulator-atf";
				reg = <2>;
				regulator-name = "vcodecsubsys";
				hisilicon,hisi-regulator-id = <2>;
				vin-supply = <&media2_subsys>;
			};

			ispsubsys: regulator@5 {
				compatible = "ip-regulator-atf";
				reg = <5>;
				regulator-name = "ispsubsys";
				hisilicon,hisi-regulator-id = <5>;
				vin-supply = <&vivobus>;
			};

			isp_srt: regulator@8 {
				compatible = "ip-regulator-atf";
				reg = <8>;
				regulator-name = "isp_srt";
				hisilicon,hisi-regulator-id = <8>;
				vin-supply = <&ispsubsys>;
			};

			ivp: regulator@3 {
				compatible = "ip-regulator-atf";
				reg = <3>;
				regulator-name = "ivp";
				hisilicon,hisi-regulator-id = <3>;
				vin-supply = <&vivobus>;
			};

			vdec: regulator@6 {
				compatible = "ip-regulator-atf";
				reg = <6>;
				regulator-name = "vdec";
				hisilicon,hisi-regulator-id = <6>;
				vin-supply = <&vcodecsubsys>;
			};

			venc: regulator@7 {
				compatible = "ip-regulator-atf";
				reg = <7>;
				regulator-name = "venc";
				hisilicon,hisi-regulator-id = <7>;
				vin-supply = <&vcodecsubsys>;
			};

			media2_subsys: regulator@12 {
				compatible = "ip-regulator-atf";
				reg = <12>;
				regulator-name = "media2_subsys";
				hisilicon,hisi-regulator-id = <12>;
			};
		};

		venc_hw: venc@e8880000 {
			compatible = "hisi,kirin970-venc";
			reg = <0x0 0xe8880000 0x0 0x40000>;
			interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "venc_norm", "venc_prot", "venc_safe";
			clocks = <&media2_crg HI3670_CLK_GATE_VENCFREQ>,
				 <&crg_ctrl HI3670_VENC_VOLT_HOLD>;
			clock-names = "clk_venc", "venc_volt_hold";
			enc_clk_rate = <0x21055e80 0x1ad27480 0xe2f9780>;
			venc_qos_mode = <2>;
			venc-supply = <&venc>;
			media-supply = <&media_subsys>;
			status = "okay";

			iommu_info {
				start-addr = <0x40000>;
				size = <0xe0000000>;
			};
		};

		ivp_smmu: iommu@e8dc0000 {
			compatible = "hisi,ivp-smmu";
			reg = <0x0 0xe8dc0000 0x0 0x20000>;
			interrupts = <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&smmu_lpae>;
			hisi,smmu-version = <2>;
			status = "okay";

			iommu_info {
				start-addr = <0x0>;
				size = <0xe0000000>;
			};
		};

		hisi_ivp: ivp@e8d80000 {
			compatible = "hisilicon,hisi-ivp";
			reg = <0x0 0xe8d80000 0x0 0x80000>,
			      <0x0 0xe8a09000 0x0 0x1000>,
			      <0x0 0xfff35000 0x0 0x1000>,
			      <0x0 0xe82b0000 0x0 0x1000>;
			interrupts = <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "ivp_irq", "ivp_dwaxi";
			clocks = <&media1_crg HI3670_CLK_GATE_IVP>;
			clock-names = "hisi-ivp-clk";
			ivp-clk-rate = <0x21055e80>;
			lowfrq-pd-clk-rate = <0xe2f9780>;
			hisi-ivp-supply = <&ivp>;
			hisi-ivp-media-supply = <&media_subsys>;
			ivp-dynamic-mem = <0x600000>;
			ivp-dynamic-mem-section-size = <0x200000>;
			status = "okay";

			ivp_mem_section {
				dram0_mem {
					section_mem = <0xe8c00000 0xe8c0000 0x30000>;
				};

				dram1_mem {
					section_mem = <0xe8c80000 0xe8c8000 0x30000>;
				};

				iram_mem {
					section_mem = <0xe8d00000 0xe8d0000 0x8000>;
				};

				ddr_mem {
					section_mem = <0xe0000000 0x1cd0000 0xd0000>;
				};

				share_mem {
					section_mem = <0xe00d0000 0x1cdd000 0x10000>;
				};

				log_mem {
					section_mem = <0xe00e0000 0x1cde000 0x20000>;
				};
			};
		};

		hisi_ivp_ipc: ivp-ipc {
			compatible = "hisilicon,hisi-ivp-ipc";
			status = "okay";
		};

		cambricon_ipu: cambricon-ipu@ff400000 {
			compatible = "hisilicon,cambricon-ipu";
			reg = <0x0 0xff400000 0x0 0x100000>,
			      <0x0 0xff500000 0x0 0x100000>;
			interrupts = <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "ipu_dma_irq";
			clocks = <&media2_crg HI3670_CLK_GATE_ICSFREQ>,
				 <&crg_ctrl HI3670_CLK_GATE_VCODECBUS_GT>,
				 <&crg_ctrl HI3670_ICS_VOLT_HIGH>,
				 <&crg_ctrl HI3670_ICS_VOLT_MIDDLE>;
			clock-names = "clk-ics", "clk_vcodecbus",
				      "ics_volt_high", "ics_volt_middle";
			iommus = <&smmu_lpae>;
			vipu-supply = <&ivp>;
			status = "okay";

			ipu-and-vcodecbus-clock-rate {
				start-rate = <0x35a4e900>;
				stop-rate = <0x13c9eb00>;
				ipu-low = <0x16e36000>;
				ipu-middle = <0x23c34600>;
				ipu-high = <0x35a4e900>;
				ipu-low-temperature = <0x23c34600>;
				vcodecbus-low = <0xb06e040>;
				vcodecbus-middle = <0x13c9eb00>;
				vcodecbus-high = <0x1ad27480>;
				vcodecbus-default = <0x18bc65c0>;
				vcodecbus-high2default = <0xd693a40>;
			};

			iommu_info {
				start-addr = <0x40000>;
				iova-align = <0x1000>;
				size = <0x80000000>;
			};

			smmu_master {
				smmu-mstr-base-addr = <0xff4a0000>;
				smmu-mstr-glb-bypass = <0x0>;
				smmu-mstr-end-ack = <0x1c>;
				smmu-mstr-smrx-start = <0x28>;
				smmu-mstr-inpt-sel = <0x34>;
				smmu-mstr-intmask = <0x40>;
				smmu-mstr-intstat = <0x48>;
				smmu-mstr-intclr = <0x4c>;
				smmu-mstr-dbg-port-in-0 = <0x70>;
				smmu-mstr-dbg-port-out = <0x78>;
				smmu-mstr-smrx-0-stream-0 = <0x100>;
				smmu-mstr-smrx-0-stream-1 = <0x104>;
				smmu-mstr-smrx-0-stream-2 = <0x108>;
				smmu-mstr-smrx-0-stream-3 = <0x10c>;
				read-cmd-total-cnt-stream-0 = <0x600>;
				read-cmd-total-cnt-stream-1 = <0x604>;
				read-cmd-total-cnt-stream-2 = <0x608>;
				read-cmd-miss-cnt-stream-0 = <0x760>;
				read-cmd-miss-cnt-stream-1 = <0x764>;
				read-cmd-miss-cnt-stream-2 = <0x768>;
				read-data-total-cnt-stream-0 = <0x8c0>;
				read-data-total-cnt-stream-1 = <0x8c4>;
				read-data-total-cnt-stream-2 = <0x8c8>;
				read-cmd-case-cnt-stream-0 = <0xa20>;
				read-cmd-case-cnt-stream-1 = <0xa24>;
				read-cmd-case-cnt-stream-2 = <0xa28>;
				read-cmd-case-cnt-stream-3 = <0xa2c>;
				read-cmd-case-cnt-stream-4 = <0xa30>;
				read-cmd-case-cnt-stream-5 = <0xa34>;
				read-cmd-trans-latency = <0xa38>;
				write-cmd-total-cnt = <0xb00>;
				write-cmd-miss-cnt = <0xc60>;
				write-data-total-cnt = <0xdc0>;
				write-cmd-case-cnt-stream-0 = <0xf20>;
				write-cmd-case-cnt-stream-1 = <0xf24>;
				write-cmd-case-cnt-stream-2 = <0xf28>;
				write-cmd-case-cnt-stream-3 = <0xf2c>;
				write-cmd-case-cnt-stream-4 = <0xf30>;
				write-cmd-case-cnt-stream-5 = <0xf34>;
				write-cmd-trans-latency = <0xf38>;
			};

			smmu_common {
				smmu-common-base-addr = <0xff480000>;
				smmu-scr = <0x0>;
				smmu-intmask-ns = <0x10>;
				smmu-intstat-ns = <0x18>;
				smmu-intclr-ns = <0x1c>;
				smmu-cb-ttbr0 = <0x204>;
				smmu-cb-ttbcr = <0x20c>;
				smmu-scachei-all = <0x214>;
				smmu-fama-ctrl1-ns = <0x224>;
				smmu-addr-msb = <0x300>;
				smmu-err-rdaddr = <0x304>;
				smmu-err-wraddr = <0x308>;
				smmu-opref-addr = <0x3a4>;
				smmu-opref-ctrl = <0x3a8>;
			};

			ics_irq {
				ics-irq-base-addr = <0xff4a2000>;
				ics-irq-mask-ns = <0x0>;
				ics-irq-status-ns = <0x8>;
				ics-irq-clr-ns = <0xc>;
			};

			ics_noc_bus {
				base-addr = <0xe8950000>;
				qos-type = <0xc>;
				factor = <0x10>;
				saturation = <0x14>;
				qos_extcontrol = <0x18>;
			};

			pmctrl {
				base-addr = <0xfff31000>;
				noc-power-idle-req = <0x380>;
				noc-power-idle-ack = <0x384>;
				noc-power-idle-stat = <0x388>;
			};

			pctrl {
				base-addr = <0xe8a09000>;
				peri-stat3 = <0xa0>;
			};

			media2 {
				base-addr = <0xe8900000>;
				peren0 = <0x0>;
				perdis0 = <0x4>;
				perclken0 = <0x8>;
				perstat0 = <0xc>;
				perrsten0 = <0x30>;
				perrstdis0 = <0x34>;
				perrststat0 = <0x38>;
			};

			peri {
				base-addr = <0xfff35000>;
				clkdiv8 = <0xc8>;
				clkdiv18 = <0xf0>;
				perpwrstat = <0x158>;
				perpwrack = <0x15c>;
				peristat7 = <0x50c>;
			};
		};

		/*
		 * Mali-G72 MP12 GPU
		 *
		 * Base address, size, interrupts and interrupt names are taken
		 * from the real device (COR-AL00 / Hi3670, sys-fdt.dtb):
		 *   mali@E82C0000, reg = <0xe82c0000 0x4000>,
		 *   interrupts = <0x102 0x103 0x104>,
		 *   interrupt-names = "JOB", "MMU", "GPU"
		 * The previous node (gpu@f4080000, "arm,mali-g72", irq 172/173/174,
		 * "gp"/"gpmmu"/"pp") was a leftover from hikey970 and matched
		 * neither the real hardware nor any mainline driver.
		 *
		 * The vendor describes the GPU with "arm,malit6xx"/"arm,mali-midgard"
		 * because it uses Mali's own Midgard kernel driver.  Mainline's
		 * Panfrost driver (drivers/gpu/drm/panfrost) covers this part too:
		 * Mali-G72 is a *Bifrost* GPU, and panfrost_gpu.c has
		 * GPU_MODEL(g72, 0x6001) while panfrost_drv.c's dt_match[] has
		 * { .compatible = "arm,mali-bifrost" }.
		 *
		 * The GPU clock (clk_g3d) and rail (g3d) are controlled by
		 * LPM3 over IPC: the clock comes from hi3670-stub-clk (channel
		 * 13) and the rail from hi3670-lpm-regulator (channel 14).
		 * Board files enable both; the node stays disabled until that
		 * power sequencing has been verified on hardware.
		 */
		gpu: gpu@e82c0000 {
			compatible = "arm,mali-bifrost";
			reg = <0x0 0xe82c0000 0x0 0x4000>;
			interrupts = <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "job", "mmu", "gpu";
			status = "disabled";
		};

		iomcu_rst: reset {
			compatible = "hisilicon,hi3660-reset";
			hisi,rst-syscon = <&iomcu>;
			#reset-cells = <2>;
		};

		uart0: serial@fdf02000 {
			compatible = "arm,pl011", "arm,primecell";
