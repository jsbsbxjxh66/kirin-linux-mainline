		};

		gpio17: gpio@e8a1c000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xe8a1c000 0x0 0x1000>;
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx5 0 8 2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&crg_ctrl HI3670_PCLK_GPIO17>;
			clock-names = "apb_pclk";
		};

		gpio18: gpio@fff28000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff28000 0x0 0x1000>;
			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx1 4 42 4>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_GPIO18>;
			clock-names = "apb_pclk";
		};

		gpio19: gpio@fff29000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff29000 0x0 0x1000>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx1 0 61 2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_GPIO19>;
			clock-names = "apb_pclk";
		};

		gpio20: gpio@e8a1f000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xe8a1f000 0x0 0x1000>;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx7 0 0 8>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&crg_ctrl HI3670_PCLK_GPIO20>;
			clock-names = "apb_pclk";
		};

		gpio21: gpio@e8a20000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xe8a20000 0x0 0x1000>;
			interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx7 0 8 4>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&crg_ctrl HI3670_PCLK_GPIO21>;
			clock-names = "apb_pclk";
		};

		gpio22: gpio@fff0b000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff0b000 0x0 0x1000>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO176 */
			gpio-ranges = <&pmx1 2 0 6>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO0>;
			clock-names = "apb_pclk";
		};

		gpio23: gpio@fff0c000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff0c000 0x0 0x1000>;
			interrupts = <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO184 */
			gpio-ranges = <&pmx1 0 6 8>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO1>;
			clock-names = "apb_pclk";
		};

		gpio24: gpio@fff0d000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff0d000 0x0 0x1000>;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO192 */
			gpio-ranges = <&pmx1 0 14 8>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO2>;
			clock-names = "apb_pclk";
		};

		gpio25: gpio@fff0e000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff0e000 0x0 0x1000>;
			interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO200 */
			gpio-ranges = <&pmx1 0 22 8>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO3>;
			clock-names = "apb_pclk";
		};

		gpio26: gpio@fff0f000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff0f000 0x0 0x1000>;
			interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO208 */
			gpio-ranges = <&pmx1 0 30 1>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO4>;
			clock-names = "apb_pclk";
		};

		gpio27: gpio@fff10000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff10000 0x0 0x1000>;
			interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			/* GPIO216 */
			gpio-ranges = <&pmx1 4 31 4>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO5>;
			clock-names = "apb_pclk";
		};

		gpio28: gpio@fff1d000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x0 0xfff1d000 0x0 0x1000>;
			interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pmx1 1 35 7>;
			interrupt-controller;
			#interrupt-cells = <2>;
			clocks = <&sctrl HI3670_PCLK_AO_GPIO6>;
			clock-names = "apb_pclk";
		};

		/* UFS */
		ufs: ufs@ff3c0000 {
			compatible = "hisilicon,hi3670-ufs", "jedec,ufs-2.1";
			/* 0: HCI standard */
			/* 1: UFS SYS CTRL */
			reg = <0x0 0xff3c0000 0x0 0x1000>,
				<0x0 0xff3e0000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI3670_CLK_GATE_UFSIO_REF>,
				 <&crg_ctrl HI3670_CLK_GATE_UFS_SUBSYS>;
			clock-names = "ref_clk", "phy_clk";
			freq-table-hz = <0 0>,
					<0 0>;
			/* offset: 0x84; bit: 12 */
			resets = <&crg_rst 0x84 12>;
			reset-names = "rst";
		};

		/* SD */
		dwmmc1: mmc@ff37f000 {
			compatible = "hisilicon,hi3670-dw-mshc",
				     "hisilicon,hi3660-dw-mshc";
			reg = <0x0 0xff37f000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI3670_CLK_GATE_SD>,
				<&crg_ctrl HI3670_HCLK_GATE_SD>;
			clock-names = "ciu", "biu";
			clock-frequency = <3200000>;
			resets = <&crg_rst 0x90 18>;
			reset-names = "reset";
			hisilicon,peripheral-syscon = <&sctrl>;
			card-detect-delay = <200>;
			status = "disabled";
		};

		/* SDIO */
		dwmmc2: mmc@fc183000 {
			compatible = "hisilicon,hi3670-dw-mshc",
				     "hisilicon,hi3660-dw-mshc";
			reg = <0x0 0xfc183000 0x0 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI3670_CLK_GATE_SDIO>,
				<&crg_ctrl HI3670_HCLK_GATE_SDIO>;
			clock-names = "ciu", "biu";
			clock-frequency = <3200000>;
			resets = <&crg_rst 0x90 20>;
			reset-names = "reset";
			card-detect-delay = <200>;
			status = "disabled";
		};

		/* I2C */
		i2c0: i2c@ffd71000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xffd71000 0x0 0x1000>;
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&iomcu HI3670_CLK_GATE_I2C0>;
			resets = <&iomcu_rst 0x20 3>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c0_pmx_func &i2c0_cfg_func>;
			status = "disabled";
		};

		i2c1: i2c@ffd72000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xffd72000 0x0 0x1000>;
			interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&iomcu HI3670_CLK_GATE_I2C1>;
			resets = <&iomcu_rst 0x20 4>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c1_pmx_func &i2c1_cfg_func>;
			status = "disabled";
		};

		i2c2: i2c@ffd73000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xffd73000 0x0 0x1000>;
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&iomcu HI3670_CLK_GATE_I2C2>;
			resets = <&iomcu_rst 0x20 5>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c2_pmx_func &i2c2_cfg_func>;
			status = "disabled";
		};

		/* IOMCU I2C6 - Hi6523 charger on COR-AL00 */
		i2c6: i2c@ffd6a000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xffd6a000 0x0 0x1000>;
			interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&iomcu HI3670_CLK_GATE_I2C6>;
			resets = <&iomcu_rst 0x20 27>;
			status = "disabled";
		};

		i2c3: i2c@fdf0c000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfdf0c000 0x0 0x1000>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&crg_ctrl HI3670_CLK_GATE_I2C3>;
			resets = <&crg_rst 0x78 7>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c3_pmx_func &i2c3_cfg_func>;
			status = "disabled";
		};

		i2c4: i2c@fdf0d000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0xfdf0d000 0x0 0x1000>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			clocks = <&crg_ctrl HI3670_CLK_GATE_I2C4>;
			resets = <&crg_rst 0x78 27>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c4_pmx_func &i2c4_cfg_func>;
			status = "disabled";
		};

		/*
		 * USB3 OTG block: the 4 KiB register window at 0xff200000 holds
		 * the misc/BC registers shared with the PHY, so describe it as a
		 * syscon and hang the mainline "hisilicon,hi3670-usb-phy" child
		 * off it (the PHY driver looks up its parent regmap as
		 * usb31misc).  Layout follows the Hi3660 binding.
		 */
		usb3_otg_bc: usb3_otg_bc@ff200000 {
			compatible = "hisilicon,hi3670-usb3-otg-bc", "syscon",
				     "simple-mfd";
			reg = <0x0 0xff200000 0x0 0x1000>;
			status = "disabled";

			usb_phy: usb-phy {
				compatible = "hisilicon,hi3670-usb-phy";
				#phy-cells = <0>;
				hisilicon,pericrg-syscon = <&crg_ctrl>;
				hisilicon,pctrl-syscon = <&pctrl>;
				hisilicon,sctrl-syscon = <&sctrl>;
				hisilicon,eye-diagram-param = <0xfdfee4>;
				hisilicon,tx-vboost-lvl = <0x5>;
			};

			bc12: bc12 {
				compatible = "hisilicon,hi3670-bc12";
				usb-role-switch = <&dwc3>;
			};
		};

		/* USB3 DWC3 */
		dwc3: usb@ff100000 {
			compatible = "snps,dwc3";
			reg = <0x0 0xff100000 0x0 0x100000>;
			interrupts = <GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 161 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "irq", "otg_irq";
			/*
			 * hclk is the register bus clock (dwc3 "bus_early"); the
			 * abb USB clock is the controller reference.  The aclk is
			 * not used for rate calculations, so it is attached as the
			 * (enable-only) "utmi" clock to keep it running.
			 */
			clocks = <&crg_ctrl HI3670_HCLK_GATE_USB3OTG>,
				 <&crg_ctrl HI3670_CLK_GATE_ABB_USB>,
				 <&crg_ctrl HI3670_ACLK_GATE_USB3DVFS>;
			clock-names = "bus_early", "ref", "utmi";
			/*
			 * PERI_CRG_PERRSTEN4 (0x90) bits 6/7: USB3OTG 32K and
			 * misc-block resets.  The reset driver asserts at 0x90
			 * and deasserts at 0x94, matching the vendor sequences
			 * in hisi_usb3_31phy.c.
			 */
			resets = <&crg_rst 0x90 6>, <&crg_rst 0x90 7>;
			phys = <&usb_phy>;
			phy-names = "usb3-phy";
			dr_mode = "otg";
			usb-role-switch;
			phy_type = "utmi";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-split-quirk;
			snps,tx_de_emphasis_quirk;
			snps,tx_de_emphasis = <1>;
			status = "disabled";
		};

		/* PCIe */
		pcie: pcie@f4000000 {
			compatible = "hisilicon,kirin970-pcie";
			reg = <0x0 0xf4000000 0x0 0x1000>,
			      <0x0 0xf4008000 0x0 0x4000>;
			reg-names = "ctrl", "apb";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			device_type = "pci";
			/*
			 * 32-bit non-prefetchable PCI memory window, taken from
			 * the vendor kirin970_pcie.dtsi ranges for RC0. Without
			 * it the node is not a valid PCI bridge and every child
			 * reg/bus-range below it fails dtc's pci checks too.
			 */
			ranges = <0x02000000 0x0 0xf5000000 0x0 0xf5000000 0x0 0x02000000>;
			interrupts = <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi";
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &gic 0 GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 2 &gic 0 GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 3 &gic 0 GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>,
					<0 0 0 4 &gic 0 GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH>;
			bus-range = <0x0 0x1>;
			clocks = <&crg_ctrl HI3670_ACLK_GATE_PCIE>;
			resets = <&crg_rst 0x40 16>;
			reset-names = "pcie";
			hisilicon,noc-target-id = <0x17>;
			status = "disabled";
		};

		/*
		 * Temperature sensors.  The TSENSOR registers are only
		 * accessible from secure firmware, so the driver reads them
		 * through an SMC call.
		 */
		tsens: thermal-sensor {
			compatible = "hisilicon,hi3670-tsensor";
			#thermal-sensor-cells = <1>;
			hisilicon,adc-start-value = <0x9a>;
			hisilicon,adc-end-value = <0x398>;
		};

		thermal-zones {
			cpu0-thermal {
				polling-delay-passive = <250>;
				polling-delay = <1000>;
				thermal-sensors = <&tsens 0>;

				trips {
					cpu0_passive: cpu0-passive {
						temperature = <80000>;
						hysteresis = <2000>;
						type = "passive";
					};

					cpu0-alert {
						temperature = <85000>;
						hysteresis = <2000>;
						type = "hot";
					};

					cpu0-crit {
						temperature = <105000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&cpu0_passive>;
						cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					};
				};
			};

			cpu1-thermal {
				polling-delay-passive = <250>;
				polling-delay = <1000>;
				thermal-sensors = <&tsens 1>;

				trips {
					cpu1_passive: cpu1-passive {
						temperature = <80000>;
						hysteresis = <2000>;
						type = "passive";
					};

					cpu1-alert {
						temperature = <85000>;
						hysteresis = <2000>;
						type = "hot";
					};

					cpu1-crit {
						temperature = <105000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&cpu1_passive>;
						cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					};
				};
			};

			gpu-thermal {
				polling-delay-passive = <250>;
				polling-delay = <1000>;
				thermal-sensors = <&tsens 2>;

				trips {
					gpu-alert {
						temperature = <85000>;
						hysteresis = <2000>;
						type = "hot";
					};

					gpu-crit {
						temperature = <105000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};
			};

			modem-thermal {
				polling-delay-passive = <250>;
				polling-delay = <1000>;
				thermal-sensors = <&tsens 3>;

				trips {
					modem-alert {
						temperature = <85000>;
						hysteresis = <2000>;
						type = "hot";
					};

					modem-crit {
						temperature = <105000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};
			};
		};

		/* Watchdog - SP805 */
		watchdog: watchdog@e8a06000 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x0 0xe8a06000 0x0 0x1000>;
			/*
			 * The GIC is #interrupt-cells = <3>, so the leading cell
			 * is redundant: it is the SPI type marker, which GIC_SPI
			 * already provides.
			 */
			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI3670_CLK_MUX_WD0>,
				 <&crg_ctrl HI3670_PCLK>;
			clock-names = "wdog_clk", "apb_pclk";
			assigned-clocks = <&crg_ctrl HI3670_CLK_MUX_WD0>;
			assigned-clock-parents = <&crg_ctrl HI3670_CLKIN_REF>;
			timeout-sec = <24>;
			status = "okay";
		};

		/* DPE - Display Processing Engine */
	dpe: dpe@e8600000 {
		compatible = "hisilicon,hi3670-dpe";
		reg = <0x0 0xe8600000 0x0 0xc0000>,  /* DSS */
		      <0x0 0xfff35000 0x0 0x1000>,   /* PERI_CRG */
		      <0x0 0xfff0a000 0x0 0x1000>,   /* SCTRL */
		      <0x0 0xe8a09000 0x0 0x1000>,   /* PCTRL */
		      <0x0 0xe86c0000 0x0 0x10000>,  /* NOC_DSS */
		      <0x0 0xfff02000 0x0 0x1000>,   /* MMBUF_CFG */
		      <0x0 0xfff31000 0x0 0x1000>,   /* PMCTRL */
		      <0x0 0xe87ff000 0x0 0x1000>;   /* MEDIA_CRG */
		reg-names = "dss_base", "peri_crg", "sctrl", "pctrl",
			    "noc_dss", "mmbuf_crg", "pmctrl", "media_crg";
		interrupts = <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dpe_pdp";
		clocks = <&media1_crg HI3670_ACLK_GATE_DSS>,
			 <&media1_crg HI3670_PCLK_GATE_DSS>,
			 <&media1_crg HI3670_CLK_GATE_EDC0>,
			 <&media1_crg HI3670_CLK_GATE_LDI0>,
			 <&media1_crg HI3670_CLK_GATE_DSS_AXI_MM>,
			 <&media1_crg HI3670_PCLK_GATE_MMBUF_CFG>,
			 <&crg_ctrl HI3670_CLK_GATE_TXDPHY0_REF>,
			 <&crg_ctrl HI3670_CLK_GATE_TXDPHY0_CFG>,
			 <&crg_ctrl HI3670_PCLK_GATE_DSI0>;
		clock-names = "dss_axi_clk",
			      "dss_pclk_dss_clk",
			      "dss_pri_clk",
			      "dss_pxl0_clk",
			      "dss_mmbuf_clk",
			      "dss_pclk_mmbuf",
			      "dss_dphy0_ref_clk",
			      "dss_dphy0_cfg_clk",
			      "dss_pclk_dsi0_clk";
		/*
		 * No CRG reset: ip_rst_dss does not exist in any PERRSTEN
		 * register on Hi3670.  The previous "<&crg_rst 0x108 0>"
		 * pointed at CLKDIV24 (offset 0x108) which is a clock
		 * divider, not a reset register, so reset_control_deassert
		 * corrupted it.  The DSS internal GLB_*_RST_EN registers are
		 * held deasserted by hardware/bootloader defaults.
		 */
		status = "disabled";
		/*
		 * Input port of the DPE: of_graph_get_port_by_id() leaves the id
		 * at its 0 default when the node carries no "reg", which is the
		 * port the DSI host encoder picks up. The soc node's
		 * #address-cells = <2> would otherwise force a two-cell "reg"
		 * that the graph_port check rejects, so - exactly as in
		 * hi6220.dtsi's ade node - the port is left bare.
		 */
		port {
			dpe_out: endpoint {
				remote-endpoint = <&dsi_in>;
			};
		};
	};

	/* DSI Host Controller */
	dsi0: dsi@e8601000 {
		compatible = "hisilicon,hi3670-dsi";
		reg = <0x0 0xe8601000 0x0 0x400>;
		clocks = <&crg_ctrl HI3670_PCLK_GATE_DSI0>;
		clock-names = "pclk";
		/* ip_prst_dsi0 = PERRSTEN3 (0x84) bit 28 */
		resets = <&crg_rst 0x84 28>;
		reset-names = "apb";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
		port {
			dsi_in: endpoint {
				remote-endpoint = <&dpe_out>;
			};
		};
	};

	/* SP804 Timer0 - always-on timer */
		timer0: timer@fff14000 {
			compatible = "arm,sp804", "arm,primecell";
			reg = <0x0 0xfff14000 0x0 0x1000>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg_ctrl HI3670_PCLK>;
			clock-names = "apb_pclk";
			status = "disabled";
		};

		/*
		 * Backlight PWM.  A single-channel PWM block in the IOMCU
		 * (always-on) region that drives the display backlight.
		 *
		 * The vendor tree names this node "hisilicon,hisiblpwm" and
		 * gives it reg 0xffd75000/0x1000, clocks = <&clk_blpwm>
		 * (a fixed-factor-clock, div 1 mult 1, off clk_fll_src =
		 * 134.4 MHz) and fpga_flag = <0>.  The vendor also muxes
		 * GPIO184/GPIO185 to BLPWM_BL/BLPWM_CABC through pinctrl.
		 *
		 * The mainline driver (pwm-hi3670-blpwm.c) exposes it as a
		 * one-channel PWM chip; the generic pwm-backlight driver
		 * consumes it via the panel's "backlight" property.
		 */
		blpwm: pwm@ffd75000 {
			compatible = "hisilicon,hi3670-blpwm";
			reg = <0x0 0xffd75000 0x0 0x1000>;
			clocks = <&iomcu HI3670_CLK_GATE_BLPWM>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		/*
		 * SPI3 - the SSP the touch panel lives on.
		 *
		 * sys-fdt.dts's spi@fff2a000 carries
		 *   compatible = "arm,pl022\0arm,primecell";
		 *   interrupts = <0x138 0x04>;   -> GIC_SPI 312
		 *   clock-names = "clk_spi3\0apb_pclk";   (both from clk_spi3)
		 *   clock-rate  = <0x4f27ac0> = 82944000 Hz
		 *   num-cs      = <0x04>;
		 * The four children are spi_dev30..33 on CS 0..3; the touch
		 * panel is spi_dev30@30 (CS 0, spi-max-frequency 0x186a0 = 100 kHz).
		 *
		 * Clocks: the vendor's "clk_spi3" is a gate on sctrl at register
		 * offset 0x1b0 bit 10 (mask 0x400) fed by sc_div_ioperi.  Mainline
		 * already models exactly that gate as HI3670_CLK_GATE_SPI
		 * (clk-hi3670.c: hi3670_sctrl_gate_sep_clks[],
		 *  { HI3670_CLK_GATE_SPI, "clk_gate_spi", "clk_div_ioperi",
		 *    0x1B0, 10 }), so it is reused here rather than inventing a
		 * new SPI3 clock.  Both clock-names therefore point at it, which
		 * also keeps the vendor's "clk_spi3 and pclk_spi3 share one bit"
		 * behaviour.
		 *
		 * The "apb_pclk" entry is mandatory, not optional:
		 * drivers/amba/bus.c::amba_get_enable_pclk() does
		 * clk_get(&dev, "apb_pclk") and hard-fails (not -EPROBE_DEFER)
		 * when it is missing, so the peripheral-ID registers could never
		 * be read and pl022 would never match.  This is why both names
		 * must be present even though pl022_probe() itself only takes a
		 * single unnamed clock (devm_clk_get_enabled(dev, NULL)).
		 */
		spi3: spi@fff2a000 {
			compatible = "arm,pl022", "arm,primecell";
			reg = <0x0 0xfff2a000 0x0 0x1000>;
			interrupts = <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sctrl HI3670_CLK_GATE_SPI>,
				 <&sctrl HI3670_CLK_GATE_SPI>;
			clock-names = "sspclk", "apb_pclk";
			num-cs = <4>;
			pinctrl-names = "default";
			pinctrl-0 = <&spi3_pmx_func &spi3_cfg_func>;
			status = "disabled";
		};
	};
};
