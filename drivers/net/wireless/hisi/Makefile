# Symbol -> directory mapping.  The Hi1102 chip on this board is driven by
# the "1102a" driver stack (the only stack ported to this kernel); the
# legacy hi1102/ tree (vendor drivers/connectivity/hisi/ mirror) is NOT
# ported and builds only behind HISI_CONNECTIVITY_HI1102_LEGACY.
obj-$(CONFIG_HISI_CONNECTIVITY_HI1102)	+= hi1102a/
obj-$(CONFIG_HISI_CONNECTIVITY_HI1102A)	+= hi1102a/
obj-$(CONFIG_HISI_CONNECTIVITY_HI1103)	+= hi1103/
obj-$(CONFIG_HISI_CONNECTIVITY_HI1102_LEGACY)	+= hi1102/
